# ============================================
# DRS VIP-AI - Environment Configuration
# ============================================

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=drs_vip_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================
# Encryption
# ============================================
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# Telegram Bot (Optional)
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================
# File Storage
# ============================================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100MB

# ============================================
# Code Interpreter
# ============================================
CODE_EXECUTION_TIMEOUT=30000
CODE_MAX_MEMORY=512

# ============================================
# Auto Builder
# ============================================
BUILD_OUTPUT_DIR=/app/builds

# ============================================
# Monitoring
# ============================================
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# ============================================
# Feature Flags
# ============================================
ENABLE_TELEGRAM=false
ENABLE_WORKFLOWS=true
ENABLE_PLUGINS=true
ENABLE_AUTO_AGENTS=true
ENABLE_CODE_INTERPRETER=true
ENABLE_CYBERSECURITY=true

# ============================================
# Performance
# ============================================
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=60000
WORKER_CONCURRENCY=4

# ============================================
# Memory Management
# ============================================
MEMORY_CONSOLIDATION_INTERVAL=86400000
MEMORY_CLEANUP_INTERVAL=3600000
VECTOR_DIMENSIONS=1536

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Development
# ============================================
NODE_ENV=production
DEBUG=false

# ============================================
# Phase 29: Self-Awareness & Transparency
# ============================================
HEALTH_REPORTING_ENABLED=true
EPISTEMIC_UNCERTAINTY=true
TRANSPARENCY_LEVEL=high
CONFIDENCE_THRESHOLD=0.65
MC_DROPOUT_PASSES=5
AUDIT_RETENTION_DAYS=365
DATA_RESIDENCY=on-premise

# ============================================
# Phase 32: GPU Acceleration
# ============================================
GPU_OFFLOAD_POLICY=adaptive
GPU_POLL_INTERVAL=2000
GPU_EVICTION_THRESHOLD=0.1

# ============================================
# Phase 33: Distributed Deployment
# ============================================
DRS_NODE_ID=master
TASK_ROUTER_STRATEGY=least_loaded
NODE_HEARTBEAT_TIMEOUT=45000
NODE_CLEANUP_INTERVAL=20000

# ============================================
# Phase 34: Federated Learning
# ============================================
FL_STRATEGY=fed_avg
FL_SECURE_AGGREGATION=true

# ============================================
# Phase 35: Multi-Region Replication
# ============================================
DRS_REGION=default
REPLICATION_MODE=async
CONFLICT_POLICY=lww
REGION_LATENCY_INTERVAL=30000

# ============================================
# Phase 36: OAuth2 / OIDC
# ============================================
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
OAUTH_MASTER_KEY=  # 64-char hex string (32 bytes) for token encryption

# ============================================
# Phase 38: GPU MIG / Time-Slicing
# ============================================
GPU_TS_MAX_CLIENTS=4
