# DRS VIP-AI Human-Centric Interaction Service
NODE_ENV=production
PORT=3034
LOG_LEVEL=info

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Features
AR_ENABLED=true
SMART_GLASSES_SUPPORT=rayban-meta,meta-orion
DUAL_BRAIN_UI=true
VOICE_FIRST=true
GESTURE_CONTROL=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_TIMEOUT=60000

ALLOWED_ORIGINS=http://localhost:3000
