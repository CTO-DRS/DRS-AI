# DRS VIP-AI Post-Quantum Security Service
# Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3032
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kyber Configuration
KYBER_MODE=768

# Dilithium Configuration
DILITHIUM_MODE=3

# Honeypot Configuration
HONEYPOT_ENABLED=true
HONEYPOT_DECEPTION_LEVEL=medium
HONEYPOT_AUTO_RESPONSE=true
HONEYPOT_THREAT_THRESHOLD=0.7

# Threat Detection Configuration
THREAT_MONITORING_INTERVAL=5000
THREAT_ANOMALY_THRESHOLD=0.8

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
