# DRS VIP-AI Self-Healing & Evolution Service
NODE_ENV=production
PORT=3035
LOG_LEVEL=info

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub
GITHUB_TOKEN=your_github_token_here

# GitLab
GITLAB_TOKEN=your_gitlab_token_here

# Auto-PR
AUTO_CREATE_PR=false
REQUIRE_APPROVAL=true
DEFAULT_BRANCH=main
PR_PREFIX=[DRS-AUTO]

# Self-Coding
AUTO_FIX=false
CONFIDENCE_THRESHOLD=0.8

# Evolution
SNAPSHOT_INTERVAL=3600000
MAX_SNAPSHOTS=168

ALLOWED_ORIGINS=http://localhost:3000
