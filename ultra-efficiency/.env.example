# DRS VIP-AI Ultra Efficiency Service
NODE_ENV=production
PORT=3033
LOG_LEVEL=info

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Hibernation
HIBERNATION_ENABLED=true
HIBERNATION_THRESHOLD=0.1
IDLE_TIMEOUT_MINUTES=30
MEMORY_THRESHOLD=85
SGX_ENABLED=false
SEV_ENABLED=false

# Distillation
DISTILLATION_ENABLED=true
DEFAULT_TEMPERATURE=4.0
DEFAULT_ALPHA=0.7
MAX_DISTILLATION_TIME=3600000

# Quantization
QUANTIZATION_ENABLED=true
DEFAULT_QUANTIZATION=int8
MIXED_PRECISION=true

# Resource Budgeting
AUTO_SCALE=true
GPU_ALLOCATION=dynamic
MEMORY_POOL_SIZE=80
CPU_LIMIT=80
SCALE_UP_THRESHOLD=70
SCALE_DOWN_THRESHOLD=30
MAX_INSTANCES=10

ALLOWED_ORIGINS=http://localhost:3000
